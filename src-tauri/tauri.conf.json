{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "conduit",
  "version": "1.1.0",
  "identifier": "my.conduit",
  "build": {
    "beforeDevCommand": "pnpm exec vite --port 5188",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "conduit",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.icns"]
  }
}
